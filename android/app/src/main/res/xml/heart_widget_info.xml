<?xml version="1.0" encoding="utf-8"?>
<!-- Four columns by two rows, resizable down to a row. One provider for the
     subject, with the layout responding to the size it is given. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="80dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:maxResizeHeight="260dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_heart"
    android:previewLayout="@layout/widget_heart"
    android:description="@string/widget_heart_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
