        android:pathData="M4,32 L30,32 L44,27 L58,26 L72,17 L96,16 L110,11 L132,10 L150,6 L172,5 L196,3 L196,34 L4,34 Z"
        android:fillColor="@color/widget_activity"
        android:fillAlpha="0.18" />
    <path
        android:pathData="M4,32 L30,32 L44,27 L58,26 L72,17 L96,16 L110,11 L132,10 L150,6 L172,5 L196,3"
