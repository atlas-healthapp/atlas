<?xml version="1.0" encoding="utf-8"?>
<!-- One drawable for every bar in the notification. Both layers are drawn white
     and coloured by the ProgressBar's own progressTint / progressBackgroundTint,
     so a family is chosen once in the layout rather than once per drawable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#ffffffff" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="#ffffffff" />
            </shape>
        </clip>
    </item>
</layer-list>
